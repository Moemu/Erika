{
  "name": "erika",
  "license": "MIT",
  "private": true,
  "description": "Erika（絵里香）——为你的仓库绘制肖像的画师少女 / A banner girl who paints portraits for your repos",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:visual",
    "test:visual": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update",
    "dev:api": "pnpm --filter @erika/api dev",
    "typecheck:vercel": "tsc -p tsconfig.vercel.json",
    "render:erika": "node packages/cli/dist/cli.js render-live --owner Moemu --repo Erika --out out/erika.webp"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0",
    "@erika/core": "workspace:*",
    "@erika/api": "workspace:*"
  }
}
