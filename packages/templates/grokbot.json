{
  "schemaVersion": 1,
  "id": "grokbot",
  "version": 3,
  "canvas": {
    "width": 3000,
    "height": 1800
  },
  "defaults": {
    "theme": "dark",
    "scale": 0.5
  },
  "layout": {
    "iconBlend": {
      "x": 0.069,
      "centerY": 0.4989,
      "size": 0.4053,
      "fit": "cover"
    },
    "iconCard": {
      "x": 0.076,
      "centerY": 0.5,
      "size": 0.332,
      "fit": "contain"
    },
    "title": {
      "x": 0.4882,
      "inkTop": 0.3828
    },
    "description": {
      "x": 0.4884,
      "top": 0.5616
    },
    "text": {
      "rightEdge": 0.9543
    }
  },
  "slots": {
    "title": {
      "font": "Torus SemiBold",
      "fontFallback": [
        "Quicksand",
        "Baloo 2",
        "Comfortaa"
      ],
      "size": 125.0,
      "tracking": 0.1,
      "accentMode": "word-initial",
      "tokenize": "[-_–—\\s]|[\\u4e00-\\u9fff]",
      "autoFit": {
        "mode": "scale-down",
        "minScale": 0.7
      },
      "overflow": "ellipsis"
    },
    "description": {
      "font": "Torus SemiBold",
      "fontFallback": [
        "Quicksand",
        "Baloo 2",
        "Comfortaa"
      ],
      "size": 58.33,
      "tracking": 0.1,
      "leading": 1.75,
      "maxLines": 5,
      "wrap": "manual-first",
      "overflow": {
        "mode": "ellipsis"
      },
      "autoFit": {
        "mode": "scale-down",
        "minScale": 0.75
      }
    },
    "icon": {
      "fit": "contain",
      "radius": 0,
      "padding": 0,
      "frame": { "padding": 0.04, "radius": 0.04 },
      "position": {
        "x": 0.5,
        "y": 0.5
      }
    },
    "meta": {
      "defaultFields": ["full_name", "stars", "forks", "issues", "release"],
      "size": 56,
      "tracking": 0.04,
      "color": "stats",
      "accent": "accent",
      "separator": "·",
      "separatorGap": 0.5,
      "topline": {
        "fields": [
          "full_name"
        ]
      },
      "footer": {
        "gap": 0.055,
        "fields": [
          "stars",
          "forks",
          "issues",
          "release",
          "license",
          "language",
          "last_updated"
        ]
      }
    }
  },
  "themes": {
    "dark": {
      "background": "#24201F",
      "title": "#FFFFFF",
      "accent": "#AB6B55",
      "description": "#999999",
      "stats": "#C4BEB8"
    },
    "light": {
      "background": "#F5F1EC",
      "title": "#1C1815",
      "accent": "#9A5A42",
      "description": "#6B6259",
      "stats": "#4B443D"
    }
  },
  "fonts": [
    "Torus-SemiBold.otf",
    "Baloo2-SemiBold.ttf",
    "Quicksand-SemiBold.ttf",
    "Comfortaa-SemiBold.ttf",
    "NotoSansSC-SemiBold.ttf"
  ],
  "_notes": "Grokbot Icon 模板：项目自带（或内置默认）的整幅插画走 iconBlend 比例盒满幅融合，画布底色由右上角采样的背景色决定；透明插画也走 iconBlend；显式主题固定底色与文字配色，不透明插画底色不匹配时使用 frame 声明的留白和圆角；iconCard 用于复杂图片。版式比例由 `erika-psd induce` 从参考 PSD 归纳（尺寸/垂直离散 ≤12px，横向 0.05–0.088W 是最松的一项，取均值）。元数据按 topline/footer 声明字段，渲染时锚定版式而非固定坐标（topline 墨迹居中于上 25% 区；footer 用墨迹间距：设计里标题→描述的墨迹间距是 0.114H，元数据取一半 0.055H≈99px，避免贴住描述）；字号 56 的依据：README 内容列约 830px，3000px 画布缩放后只剩 27.7%，56×0.277≈15.5px 屏幕字号（与描述 58.33 同档、比正文略小），42 会掉到 11.6px 而难以辨认。描述文本支持 `**强调**` 标记：成对出现时该段用主题 accent 色绘制，标记本身不参与度量与换行（落单的 `**` 按字面输出）。",
  "fontCjk": "Noto Sans SC"
}
